# -----------------------------------------------
# Web Security Platform — Environment Variables
# -----------------------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# --- AI Engine (Google Gemini - Free Tier) ---
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Flask Dashboard ---
FLASK_PORT=5000
FLASK_DEBUG=true

# --- Target Site (XAMPP) ---
TARGET_SITE_URL=http://localhost:8000/

# supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
